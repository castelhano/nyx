enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  DOMESTIC_PARTNERSHIP
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum ContractType {
  CLT
  PJ
  TEMPORARY
  INTERNSHIP
  APPRENTICE
}

enum ContractStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
  EXPIRED
}

model Department {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  jobTitles JobTitle[]

  @@map("departments")
}

model JobTitle {
  id           String     @id @default(uuid())
  departmentId String
  name         String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  contracts  Contract[]
  crewRole   CrewRoleJobTitle?

  @@map("job_titles")
}

model Employee {
  id              String         @id @default(uuid())
  branchId        String
  code            String         @unique
  fullName        String
  preferredName   String?
  taxId           String         @unique
  dateOfBirth     DateTime?
  gender          Gender?
  maritalStatus   MaritalStatus?
  email           String?
  phone           String?
  photoUrl        String?
  status          EmployeeStatus @default(ACTIVE)
  hireDate        DateTime
  terminationDate DateTime?
  notes           String?

  branch    Branch     @relation(fields: [branchId], references: [id])
  contracts Contract[]
  crewMember CrewMember?
  changes    EmployeeChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

enum EmployeeChangeOrigin {
  STAFF  // the HR screen
  PORTAL // the crew member himself, in the crew portal
}

// A change to a tracked field of an Employee (today only the phone) — who changed it, from what
model EmployeeChange {
  id         String               @id @default(uuid())
  employeeId String
  field      String
  oldValue   String?
  newValue   String?
  origin     EmployeeChangeOrigin
  // STAFF: the user who saved it
  userId     String?
  createdAt  DateTime             @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@map("employee_changes")
}

model Contract {
  id          String         @id @default(uuid())
  employeeId  String
  jobTitleId  String
  type        ContractType
  startDate   DateTime
  endDate     DateTime?
  salary      Decimal
  weeklyHours Int            @default(44)
  // worked days per week — the daily journey is weeklyHours / workDaysPerWeek (42h / 6 = 7h)
  workDaysPerWeek Int        @default(6)
  status      ContractStatus @default(ACTIVE)
  notes       String?

  employee Employee @relation(fields: [employeeId], references: [id])
  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contracts")
}

enum LineType {
  URBAN
  METROPOLITAN
  RURAL
  SPECIAL
}

enum RouteDirection {
  OUTBOUND
  INBOUND
  CIRCULAR
}

enum TravelTimeSource {
  OSRM
  MANUAL
}

enum VehiclePlanStatus {
  DRAFT
  ACTIVE
}

enum LineScheduleStatus {
  DRAFT
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum DeadrunType {
  ACCESS
  RETURN
  DISPLACEMENT

  @@map("transit_deadrun_type")
}

enum LayoverPolicy {
  DEFAULT
  HOLD
  DEPOT
}

// A point in the network — bus stop, terminal, or depot. Shared by routes (as stops),
// travel-time matrix entries, and vehicle blocks/deadruns (as depot/origin/destination).
// isDepot marks it as eligible for a block's home depot and for deadrun endpoints.
model TransitLocality {
  id        String   @id @default(uuid())
  code      String   @unique
  abbr      String?
  name      String
  lat       Float?
  lng       Float?
  isDepot   Boolean  @default(false)
  notes     String?
  // SnapInfo (packages/schemas/transit/locality.schema.ts) — set by OsrmService when
  // snapping this locality's coordinates onto the OSRM road network:
  // { lat, lng, distanceM, roadName?, checkedAt: ISO datetime }
  snapInfo  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travelTimesFrom      TravelTimeMatrix[] @relation("TravelTimeOrigin")
  travelTimesTo        TravelTimeMatrix[] @relation("TravelTimeDestination")
  routesAsOrigin       TransitRoute[]     @relation("RouteOrigin")
  routesAsDestination  TransitRoute[]     @relation("RouteDestination")
  routesAsHomeDepot    TransitRoute[]     @relation("RouteHomeDepot")
  routeLocalities      RouteLocality[]
  vehicleBlocks        VehicleBlock[]
  deadrunsAsOrigin     BlockDeadrun[]     @relation("DeadrunOrigin")
  deadrunsAsDestination BlockDeadrun[]    @relation("DeadrunDestination")

  @@map("transit_localities")
}

// A public transit line — the top-level entity riders identify by code (e.g. "308").
// Groups routes (one per direction/variant), schedules, and vehicle plan membership.
// A line can be scoped (scopeId) to restrict which VehiclePlan it can be materialized in.
model TransitLine {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      LineType
  isActive  Boolean  @default(true)
  scopeId   String?
  // marks this line as a variant/derivative of another (e.g. "308B" of "308") — shares
  // the parent's OSO (approvalRef) and is used for family-wide demand/km aggregation.
  // A line with a parentLineId cannot itself be a parent (enforced in LineService), so
  // the chain depth is always at most 1.
  parentLineId String?
  notes     String?
  // shape mirrors LineSchema['metrics'] (packages/schemas/transit/line.schema.ts), plus
  // `demand` — populated via LineController's POST /transit-line/demand/apply, not yet
  // formalized in the zod schema:
  // {
  //   "extensionKm": {"OUTBOUND":16.5,"INBOUND":16.5,"CIRCULAR"?:number},
  //   "windows": {
  //     "<dayTypeCode>": {
  //       "OUTBOUND":[{"from":4,"to":5,"minutes":54,"intervalMinutes":10,"isDerived"?:false}, ...],
  //       "INBOUND":[...], "CIRCULAR":[...]
  //     }, ...
  //   },
  //   "demand": {
  //     "<dayTypeCode>": {
  //       "OUTBOUND":{"4":24,"5":241,...},   // hour → boardings
  //       "INBOUND":{...}, "CIRCULAR":{...}
  //     }, ...
  //   },
  //   "renewalIndex": {
  //     "OUTBOUND":{"value":81.25,"peakPax":145,"peakTripId":"trip_1399","tripCount":159,
  //                 "avgPax":41.75,"assumedCapacity":80,"method":"cut_planned_end",
  //                 "computedAt":"2026-08-17T14:46:16","sourceFile":"FULL_2026_08_03_....json"},
  //     "INBOUND":{...}, "CIRCULAR":{...}, "overall":{...}
  //   }
  // }
  metrics   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scope      Scope?           @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  parentLine TransitLine?     @relation("LineVariants", fields: [parentLineId], references: [id])
  childLines TransitLine[]    @relation("LineVariants")
  routes     TransitRoute[]
  planLines  VehiclePlanLine[]
  exceptions LineCalendarExceptionLine[]
  lineGroups LineGroupLine[]
  schedules  LineSchedule[]

  @@map("transit_lines")
}

// One direction (or circular variant) of a line's trajectory — the ordered path a
// vehicle follows between originLocality and destinationLocality. A line can have
// several routes per direction (variants sharing the same lineId+direction,
// disambiguated by ordinal); isPrimary marks the one whose trajectory is authoritative.
model TransitRoute {
  id                    String         @id @default(uuid())
  lineId                String
  direction             RouteDirection
  name                  String
  originLocalityId      String
  destinationLocalityId String
  isActive              Boolean        @default(true)
  // internal disambiguator for multiple route variants sharing the same (lineId,
  // direction) — assigned by RouteService on create (0, 1, 2...), never user-facing
  ordinal               Int            @default(0)
  // the route whose trajectory represents the line's official extension for this
  // direction, used to confront TransitLine.metrics.extensionKm — at most one per
  // (lineId, direction), enforced in RouteService
  isPrimary             Boolean        @default(false)
  // manual override for the trajectory color on Régua/Mapa — null falls back to the
  // direction's default color (see DIR_COLOR in the frontend)
  color                 String?
  // schedule generator: behavior when closing a trip at an intermediate stop —
  // DEFAULT inherits TransitSettings.defaultLayoverPolicy, HOLD/DEPOT overrides per route
  layoverPolicy         LayoverPolicy  @default(DEFAULT)
  // preferred depot for the return leg when layoverPolicy resolves to DEPOT — optional,
  // falls back to the nearest available depot (see the schedule generator)
  homeDepotId           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  line                TransitLine     @relation(fields: [lineId], references: [id])
  originLocality      TransitLocality @relation("RouteOrigin", fields: [originLocalityId], references: [id])
  destinationLocality TransitLocality @relation("RouteDestination", fields: [destinationLocalityId], references: [id])
  homeDepot           TransitLocality? @relation("RouteHomeDepot", fields: [homeDepotId], references: [id])
  localities          RouteLocality[]
  trips               TransitTrip[]
  lineDepartures      LineDeparture[]

  @@unique([lineId, direction, ordinal])
  @@map("transit_routes")
}

// One entry in a route's ordered stop sequence — either a real stop (localityId set)
// or a routing waypoint (localityId null, forces OSRM through a raw lat/lng without
// stopping). deltaMinutes/deltaKm hold the leg's cost from the previous entry.
model RouteLocality {
  id               String           @id @default(uuid())
  routeId          String
  // null = routing waypoint (forces OSRM through a point without being a bus stop)
  localityId       String?
  // populated when localityId is null (waypoint coords)
  lat              Float?
  lng              Float?
  sequence         Int
  // null → runtime falls back to TravelTimeMatrix for this pair
  deltaMinutes     Int?
  deltaKm          Float?
  // protects manual overrides from being clobbered by auto-generation
  deltaSource      TravelTimeSource @default(OSRM)
  // GeoJSON LineString for the leg from the previous stop to this one; null for sequence=1.
  // Stored opaquely — z.unknown() in RouteLocality's schema, never introspected server-side.
  geometry         Json?
  allowsCrewChange Boolean          @default(false)
  // marks this stop as a reference point that must appear as its own column in the OSO
  // export — cycle endpoints always appear regardless, this only matters for intermediate
  // stops (see docs/proposal/plan_oso_export_v1.md)
  includeInOso     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  route    TransitRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  // nulls are treated as distinct in both SQLite and PG — multiple waypoints per route are allowed
  locality TransitLocality? @relation(fields: [localityId], references: [id])

  // no @@unique([routeId, localityId]) — a circular route legitimately uses the
  // same locality for both its origin (sequence 1) and destination (last sequence)
  @@unique([routeId, sequence])
  @@map("transit_route_localities")
}

// Precomputed travel time/distance between two localities — the fallback used by a
// RouteLocality leg when it doesn't override deltaMinutes/deltaKm, and by the solver
// for deadruns. Directional: (origin, destination) is a distinct row from its reverse.
model TravelTimeMatrix {
  id             String           @id @default(uuid())
  originId       String
  destinationId  String
  baseMinutes    Float
  distanceKm     Float
  // multiplier applied to baseMinutes by the solver (e.g. > 1 for bottlenecks/construction)
  speedRatio     Float            @default(1.0)
  source         TravelTimeSource @default(MANUAL)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  origin      TransitLocality @relation("TravelTimeOrigin", fields: [originId], references: [id])
  destination TransitLocality @relation("TravelTimeDestination", fields: [destinationId], references: [id])

  @@unique([originId, destinationId])
  @@map("transit_travel_times")
}

// A calendar classification (e.g. weekday, Saturday, Sunday/holiday) that selects
// which schedules and trips run on a given date. A DayType with no pattern only
// ever applies via an explicit LineCalendarException, never by date matching.
model DayType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  // DayTypePattern (packages/schemas/transit/day-type.schema.ts) — discriminated union:
  // { type: "weekdays", days: number[] }                           days: 1-7 (ISO weekday)
  // { type: "month_window", anchor: "start"|"end", days: number, baseWeekdays?: number[] }
  pattern     Json?
  priority    Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trips                        TransitTrip[]
  vehiclePlans                 VehiclePlan[]
  lineSchedules                LineSchedule[]
  calendarExceptionsAsOverride LineCalendarException[] @relation("ExceptionOverrideDayType")
  calendarExceptionsAsSource   LineCalendarException[] @relation("ExceptionSourceDayType")

  @@map("transit_day_types")
}

// A date-range override that swaps which DayType a set of lines operates under (e.g.
// a holiday that should run Sunday service). sourceDayTypeId optionally scopes the
// override to lines currently running under that specific day type.
model LineCalendarException {
  id                String    @id @default(uuid())
  validFrom         DateTime
  validTo           DateTime?
  sourceDayTypeId   String?
  overrideDayTypeId String
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sourceDayType   DayType?                   @relation("ExceptionSourceDayType", fields: [sourceDayTypeId], references: [id])
  overrideDayType DayType                    @relation("ExceptionOverrideDayType", fields: [overrideDayTypeId], references: [id])
  lines           LineCalendarExceptionLine[]

  @@map("transit_line_calendar_exceptions")
}

// Join table — which lines a LineCalendarException applies to.
model LineCalendarExceptionLine {
  exceptionId String
  lineId      String

  exception LineCalendarException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  line      TransitLine           @relation(fields: [lineId], references: [id])

  @@id([exceptionId, lineId])
  @@map("transit_line_calendar_exception_lines")
}

// A line's officially planned service — the sequence of departures per direction
// that the line operates under, as agreed with the granting authority.
// Identified per (line, dayType) by approvalRef (a OSO number issued by the
// authority): at most one APPROVED version at a time; approving a new one
// supersedes the previous APPROVED record, which is kept for history.
model LineSchedule {
  id          String             @id @default(uuid())
  lineId      String
  dayTypeId   String
  status      LineScheduleStatus @default(DRAFT)
  // vigencia — set when the version is approved
  validFrom   DateTime?
  // set when superseded by a newer approved version
  validTo     DateTime?
  // official number generated by authority — business identity of this record
  approvalRef String
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  line             TransitLine       @relation(fields: [lineId], references: [id])
  dayType          DayType           @relation(fields: [dayTypeId], references: [id])
  departures       LineDeparture[]
  vehiclePlanLines VehiclePlanLine[]

  @@unique([lineId, dayTypeId, approvalRef])
  @@map("transit_line_schedules")
}

// A single approved departure — direction + time (+ vehicle type when the 
// managing body already specifies it in the service order).
// This is the actual "departure" that gets approved; frozen once its 
// LineSchedule leaves DRAFT.
model LineDeparture {
  id               String       @id @default(uuid())
  lineScheduleId   String
  routeId          String
  departureMinutes Int
  requiredVehicleType VehicleType?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  lineSchedule LineSchedule  @relation(fields: [lineScheduleId], references: [id])
  route        TransitRoute  @relation(fields: [routeId], references: [id])

  @@map("transit_line_departures")
}

// A single scheduled run of a route on a given day type — the operational unit that
// vehicle blocks are built from (via BlockTrip). May trace back to an approved
// LineDeparture or be free-standing (e.g. an ad-hoc reinforcement trip).
model TransitTrip {
  id                  String       @id @default(uuid())
  routeId             String
  dayTypeId           String
  // minutes from operational day start; values > 1440 indicate overnight trips
  departureMinutes    Int
  arrivalMinutes      Int
  requiredVehicleType VehicleType?
  // TripConstraints (packages/schemas/transit/trip.schema.ts) — { locked?: string[] },
  // field names the solver must not modify, e.g. {"locked":["departureMinutes"]}
  constraints         Json?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  route         TransitRoute   @relation(fields: [routeId], references: [id])
  dayType       DayType        @relation(fields: [dayTypeId], references: [id])
  blockTrips    BlockTrip[]

  @@map("transit_trips")
}

// A user-defined kind of non-productive stop within a block (meal, shift change,
// wait...). minMinutes/maxMinutes are informative only — they never block a
// BlockInterval outside the range, only flag it as irregular in the UI.
model IntervalType {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  isPaid     Boolean  @default(false)
  minMinutes Int?
  maxMinutes Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  blockIntervals BlockInterval[]

  @@map("transit_interval_types")
}

// A stop within a block (meal, shift change, wait time...). No FK to the preceding
// trip — the link is positional (the nearest productive trip prior to it
// in the block sequence). The solver does not maintain this consistency:
// when regenerating a plan, existing intervals disappear via `onDelete: Cascade`
// along with the recreated blocks. See docs/proposal/vehicle-plan-block-intervals.md
model BlockInterval {
  id               String   @id @default(uuid())
  vehicleBlockId   String
  intervalTypeId   String
  departureMinutes Int
  arrivalMinutes   Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicleBlock VehicleBlock @relation(fields: [vehicleBlockId], references: [id], onDelete: Cascade)
  intervalType IntervalType @relation(fields: [intervalTypeId], references: [id])

  @@map("transit_block_intervals")
}

// A generated vehicle-block plan for one (scope, dayType) combination — the solver's
// output artifact, holding blocks/lines plus scoring summaries. Multiple plans (drafts,
// revisions) may exist for the same scope/dayType; nothing enforces a single ACTIVE one.
model VehiclePlan {
  id          String            @id @default(uuid())
  scopeId     String
  dayTypeId   String
  description String?
  status      VehiclePlanStatus @default(DRAFT)
  // VehiclePlanSummary (packages/schemas/transit/vehicle-plan.schema.ts) — populated by
  // the solver after generation:
  // {"fleetCount":102,"score":0,"deadrunKm":0,"productiveKm":23249.58,"totalKm":23249.58,
  //  "deadrunMinutes":6650,"productiveMinutes":73213,"totalMinutes":98230,
  //  "errors"?:{"missingMatrix":[{"origin":"...","destination":"..."}]}}
  summary     Json?
  generatedAt DateTime?
  // VehiclePlanConstraints (packages/schemas/transit/vehicle-plan.schema.ts) — { locked?: true }
  constraints Json?
  // Partial<SolverPlanningConfig> (solver/solver.types.ts) — per-plan override snapshot
  // of the global planning settings, applied on top of TransitSettings when this plan
  // is (re)generated
  metrics     Json?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  scope   Scope             @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  dayType DayType           @relation(fields: [dayTypeId], references: [id])
  lines   VehiclePlanLine[]
  blocks  VehicleBlock[]

  @@map("transit_vehicle_plans")
}

// Universo de linhas + operadores de um projeto — todo VehiclePlan pertence a
// exatamente um Scope, que define quais linhas podem ser materializadas nele.
// Uso futuro: base para composição de escala de motoristas (ScopeOperator.share).
model Scope {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  // grantor's logo, printed in the exported OSO's header
  logoUrl     String?
  // ScopeOsoConfig (packages/schemas/transit/scope.schema.ts) — { organName?, signatures: [{role, name}] }
  osoConfig   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines        TransitLine[]
  operators    ScopeOperator[]
  vehiclePlans VehiclePlan[]

  @@map("transit_scopes")
}

// Branch operating within a Scope — abbr/share reserved for future use
// (driver scheduling)
model ScopeOperator {
  id        String   @id @default(uuid())
  scopeId   String
  branchId  String
  abbr      String
  share     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scope  Scope  @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  branch Branch @relation("BranchScopeOperators", fields: [branchId], references: [id])

  @@unique([scopeId, branchId])
  @@map("transit_scope_operators")
}

// Join table — which lines are materialized in a VehiclePlan, plus per-plan schedule
// pinning (lineScheduleId) and drift tracking (isDrifted); see field comments.
model VehiclePlanLine {
  vehiclePlanId String
  lineId        String
  // pins which approved LineSchedule version governs this line within this specific
  // plan — null while the line is still "em análise" (no approved schedule yet).
  // Set automatically when the line is added; does not follow newer approvals
  // silently, so the plan stays traceable/stable against the OS it was built on.
  lineScheduleId String?
  // set when a trip belonging to this line (in this plan) is edited/removed in a way
  // that diverges from its linked LineDeparture — signals that formalizing a new
  // LineSchedule version (with all of this line's current trips) may be warranted.
  // Cleared when the line's schedule is switched/rematerialized.
  isDrifted      Boolean       @default(false)
  // VehiclePlanLineSummary (packages/schemas/transit/vehicle-plan.schema.ts) — populated
  // by VehiclePlanService.scorePlan() (grouped by line):
  // {"fleetSize":5,"dailyTrips":98,"operatingHours":18,"dailyKm":1813.2,"avgSpeed":21.2,
  //  "occupancyIndex":0.82,"serviceFrequencyIndex":5.44,"peakPassengersPerHour":350,"score":0}
  summary        Json?

  vehiclePlan  VehiclePlan   @relation(fields: [vehiclePlanId], references: [id], onDelete: Cascade)
  line         TransitLine   @relation(fields: [lineId], references: [id])
  lineSchedule LineSchedule? @relation(fields: [lineScheduleId], references: [id])

  @@id([vehiclePlanId, lineId])
  @@map("transit_vehicle_plan_lines")
}

// One vehicle's daily duty within a plan — the ordered sequence of trips (BlockTrip),
// deadruns, and intervals it performs. blockNumber is the human-facing id ("carro X"),
// unique per plan.
model VehicleBlock {
  id            String      @id @default(uuid())
  vehiclePlanId String
  branchId      String?
  blockNumber   Int
  depotId       String
  vehicleType VehicleType
  // true when any trip in the block was modified, used for update summary
  isStale     Boolean     @default(false)
  // VehicleBlockSummary (packages/schemas/transit/vehicle-block.schema.ts) — populated by
  // the solver:
  // {"totalMinutes":1127,"productiveMinutes":758,"deadrunMinutes":47,"totalKm":439.2,
  //  "productiveKm":439.2,"deadrunKm":0}
  summary     Json?
  // VehicleBlockConstraints (packages/schemas/transit/vehicle-block.schema.ts) — { locked?: true }
  constraints Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  vehiclePlan   VehiclePlan     @relation(fields: [vehiclePlanId], references: [id], onDelete: Cascade)
  branch        Branch?         @relation("BranchVehicleBlocks", fields: [branchId], references: [id])
  depot         TransitLocality @relation(fields: [depotId], references: [id])
  blockTrips     BlockTrip[]
  blockDeadruns  BlockDeadrun[]
  blockIntervals BlockInterval[]

  @@unique([vehiclePlanId, blockNumber])
  @@map("transit_vehicle_blocks")
}

// A user-defined grouping of lines for reporting/aggregation, optionally scoped to a branch.
model LineGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  branchId  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch?         @relation("BranchLineGroups", fields: [branchId], references: [id])
  lines  LineGroupLine[]

  @@map("transit_line_groups")
}

// Join table — which lines belong to a LineGroup.
model LineGroupLine {
  lineGroupId String
  lineId      String

  lineGroup LineGroup   @relation(fields: [lineGroupId], references: [id], onDelete: Cascade)
  line      TransitLine @relation(fields: [lineId], references: [id])

  @@id([lineGroupId, lineId])
  @@map("transit_line_group_lines")
}

// Join table (ordered) — assigns a TransitTrip to a VehicleBlock; sequence defines
// the trip's position within the block's duty.
model BlockTrip {
  id             String   @id @default(uuid())
  vehicleBlockId String
  tripId         String
  sequence       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicleBlock VehicleBlock @relation(fields: [vehicleBlockId], references: [id], onDelete: Cascade)
  trip         TransitTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([vehicleBlockId, sequence])
  @@map("transit_block_trips")
}

// A non-revenue movement within a block. type distinguishes ACCESS (garage → first
// trip), RETURN (last trip → garage), and DISPLACEMENT (between two disconnected trips).
model BlockDeadrun {
  id                    String      @id @default(uuid())
  vehicleBlockId        String
  type                  DeadrunType
  originLocalityId      String
  destinationLocalityId String
  departureMinutes      Int
  arrivalMinutes        Int
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  vehicleBlock        VehicleBlock    @relation(fields: [vehicleBlockId], references: [id], onDelete: Cascade)
  originLocality      TransitLocality @relation("DeadrunOrigin", fields: [originLocalityId], references: [id])
  destinationLocality TransitLocality @relation("DeadrunDestination", fields: [destinationLocalityId], references: [id])

  @@map("transit_block_deadruns")
}

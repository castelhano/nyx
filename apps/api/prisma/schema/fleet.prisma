enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
  DECOMMISSIONED
}

enum FuelType {
  DIESEL
  GASOLINE
  ETHANOL
  ELECTRIC
  HYBRID
  GNV
}

enum VehicleType {
  STANDARD
  ARTICULATED
  BI_ARTICULATED
  MICRO_BUS
  MINIBUS
  VAN
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

model VehicleBrand {
  id        String         @id @default(uuid())
  name      String         @unique
  models    VehicleModel[]
  vehicles  Vehicle[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("vehicle_brands")
}

model VehicleModel {
  id        String       @id @default(uuid())
  name      String
  brandId   String
  brand     VehicleBrand @relation(fields: [brandId], references: [id])
  vehicles  Vehicle[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([name, brandId])
  @@map("vehicle_models")
}

model Vehicle {
  id               String            @id @default(uuid())
  branchId         String
  code             String            @unique
  plate            String            @unique
  renavam          String?           @unique
  chassis          String?           @unique
  brandId          String?
  modelId          String?
  year             Int?
  modelYear        Int?
  vehicleType      VehicleType       @default(STANDARD)
  color            String?
  fuelType         FuelType          @default(DIESEL)
  transmission     TransmissionType?
  seatedCapacity   Int?
  totalCapacity    Int?
  odometer         Float             @default(0)
  status           VehicleStatus     @default(ACTIVE)
  acquisitionDate  DateTime?
  acquisitionValue Decimal?
  notes            String?

  branch Branch       @relation(fields: [branchId], references: [id])
  brand  VehicleBrand? @relation(fields: [brandId], references: [id])
  model  VehicleModel? @relation(fields: [modelId], references: [id])

  crewMembers      CrewMember[]
  unavailabilities VehicleUnavailability[]
  dailyBlocks      DailyBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

// A vehicle out of service over a date range (maintenance, inspection, accident...) — the daily
// operation won't put it on a block. Vehicle.status keeps saying how it is now.
model VehicleUnavailability {
  id        String    @id @default(uuid())
  vehicleId String
  startDate DateTime  @db.Date
  // inclusive; null = open-ended
  endDate   DateTime? @db.Date
  reason    String
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startDate])
  @@map("vehicle_unavailabilities")
}

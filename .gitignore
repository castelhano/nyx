# dependencies
node_modules

# build outputs
dist
.next

# prisma generated client
**/src/generated/

# sqlite
*.db
*.db-journal
*.db-shm
*.db-wal

# local pg_dump safety snapshots (ad-hoc, not the sync mechanism — see prisma/fixtures/)
apps/api/prisma/backup_pre_reset_*.sql

# environment files
.env
.env.*.local

# logs
*.log

# editor directories
.vscode/
.idea/
.claude/

# macOS
.DS_Store

# turborepo cache
.turbo/

# file uploads (preserve directory via .gitkeep)
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# osrm data (pbf download + generated graph files)
osrm/data/*
!osrm/data/.gitkeep
